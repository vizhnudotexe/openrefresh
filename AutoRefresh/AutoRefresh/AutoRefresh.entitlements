<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Background processing is a standard entitlement for sideloaded apps.
	     SideStore/AltStore sign this with free developer account entitlements.
	     You do NOT need a paid account if installing via SideStore itself. -->
	<key>com.apple.developer.background-task-scheduler</key>
	<true/>
</dict>
</plist>
